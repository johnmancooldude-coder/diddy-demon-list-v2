const cfg=window.DIDDY_CONFIG||{};const sb=cfg.SUPABASE_URL&&cfg.SUPABASE_ANON_KEY?supabase.createClient(cfg.SUPABASE_URL,cfg.SUPABASE_ANON_KEY):null;const $=id=>document.getElementById(id);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const ptsRank=r=>Math.max(1,Math.round(100-99*Math.pow((Number(r)-1)/99,.62)));let D={};let homeChart=null;
async function load(){if(!sb){$('notice').innerHTML='<div class="panel error">Configure Supabase first.</div>';return}const q=await Promise.all([sb.from('list_settings').select('*').limit(1).single(),sb.from('levels').select('*').order('section').order('rank'),sb.from('players').select('*').order('name'),sb.from('records').select('*').order('created_at',{ascending:false}),sb.from('point_values').select('*').order('rank'),sb.from('placement_history').select('*').order('recorded_at',{ascending:false}),sb.from('player_leaderboard').select('*').order('total_points',{ascending:false}),sb.rpc('get_featured_level'),sb.from('v18_news_posts').select('*').order('created_at',{ascending:false}).limit(6)]);const bad=q.find(x=>x.error&&x!==q[7]);if(bad?.error){$('notice').innerHTML=`<div class="panel error">${esc(bad.error.message)}</div>`;return}D={settings:q[0].data||{},levels:q[1].data||[],players:q[2].data||[],records:q[3].data||[],points:q[4].data||[],history:q[5].data||[],lb:q[6].data||[],featured:q[7].data?.id||null,news:q[8].data||[]};renderHome();renderList();}
function p(r){return Number(D.points.find(x=>Number(x.rank)===Number(r))?.points||ptsRank(r))}function wins(levelId){return D.records.filter(r=>r.level_id===levelId).length}function levelBy(id){return D.levels.find(l=>l.id===id)}function playerBy(id){return D.players.find(x=>x.id===id)}
function renderHome(){ $('listName').textContent=D.settings.list_name||'DIDDY DEMON LIST';$('tagline').textContent=D.settings.tagline||'The most scientifically questionable demon list on Earth.';$('levelCount').textContent=D.levels.length;$('playerCount').textContent=D.players.length;$('victoryCount').textContent=D.records.length;const one=D.levels.filter(x=>x.section==='main').sort((a,b)=>a.rank-b.rank)[0];const top=D.lb[0];const feat=levelBy(D.featured);const latest=D.levels.slice().sort((a,b)=>new Date(b.created_at)-new Date(a.created_at))[0];linkCard('numberOneLevel',one,one?`#${one.rank} · ${one.name}`:'—','level.html');$('numberOneMeta').textContent=one?`${p(one.rank)} points · ${wins(one.id)} victories`:'—';linkPlayer('topPlayer',top);$('topPlayerPts').textContent=top?`${Number(top.total_points||0).toLocaleString()} points · ${top.victories||0} victories`:'—';linkCard('featuredLevel',feat,feat?`#${feat.rank} · ${feat.name}`:'No featured level','level.html');$('featuredMeta').textContent=feat?`${p(feat.rank)} points`:'—';linkCard('latestLevel',latest,latest?`#${latest.rank} · ${latest.name}`:'—','level.html');$('latestMeta').textContent=latest?new Date(latest.created_at).toLocaleDateString():'—';
 const DAY=864e5,now=Date.now(),oneDay=DAY,threeDays=3*DAY;const latestBy={};D.history.forEach(h=>{if(!latestBy[h.level_id])latestBy[h.level_id]=[];latestBy[h.level_id].push(h)});const movers=[];Object.entries(latestBy).forEach(([id,hs])=>{const a=hs[0],age=now-new Date(a.recorded_at).getTime(),b=hs.find(x=>new Date(x.recorded_at)<new Date(a.recorded_at));if(age<=oneDay&&b&&a.rank!==b.rank){movers.push({l:levelBy(id),delta:Number(b.rank)-Number(a.rank),from:b.rank,to:a.rank})}});renderMover('climbers',movers.filter(x=>x.delta>0).sort((a,b)=>b.delta-a.delta).slice(0,5),true);renderMover('falls',movers.filter(x=>x.delta<0).sort((a,b)=>a.delta-b.delta).slice(0,5),false);
 const hot={};D.records.filter(r=>now-new Date(r.created_at).getTime()<=threeDays).forEach(r=>hot[r.level_id]=(hot[r.level_id]||0)+1);$('trendingHome').innerHTML=Object.entries(hot).sort((a,b)=>b[1]-a[1]).slice(0,5).map(([id,n])=>{const l=levelBy(id);return l?`<a class="adminRow row between" href="level.html?id=${l.id}"><span><b>#${l.rank} · ${esc(l.name)}</b><span class="meta"> ${esc(l.difficulty||'')} · last 3 days</span></span><strong>🔥 ${n} recent</strong></a>`:''}).join('')||'<p class="meta">No activity in the last 3 days.</p>';
 const recentByPlayer={};D.records.filter(r=>now-new Date(r.created_at).getTime()<=threeDays).forEach(r=>{const pts=p(levelBy(r.level_id)?.rank||101);recentByPlayer[r.player_id]??={wins:0,pts:0};recentByPlayer[r.player_id].wins++;recentByPlayer[r.player_id].pts+=pts});const priorByPlayer={};D.records.filter(r=>{const age=now-new Date(r.created_at).getTime();return age>threeDays&&age<=6*DAY}).forEach(r=>{const pts=p(levelBy(r.level_id)?.rank||101);priorByPlayer[r.player_id]??={wins:0,pts:0};priorByPlayer[r.player_id].wins++;priorByPlayer[r.player_id].pts+=pts});const rising=D.players.map(pl=>{const r=recentByPlayer[pl.id]||{wins:0,pts:0},pr=priorByPlayer[pl.id]||{wins:0,pts:0};return {...pl,r,pr,growth:r.pts-pr.pts}}).filter(x=>x.r.wins>0).sort((a,b)=>b.growth-a.growth||b.r.pts-a.r.pts||b.r.wins-a.r.wins).slice(0,5);$('risingPlayers').innerHTML=rising.map(x=>{const growth=x.growth>=0?`+${x.growth}`:`${x.growth}`;return `<a class="adminRow row between" href="player.html?id=${x.id}"><span><b>${esc(x.name)}</b><span class="meta"> ${x.r.wins} wins · last 3 days · ${growth} pts vs prior 3d</span></span><strong>${x.r.pts.toLocaleString()} pts</strong></a>`}).join('')||'<p class="meta">No rising players in the last 3 days.</p>';
 const recentWins=D.records.filter(r=>now-new Date(r.created_at).getTime()<=oneDay);$('recentVictories').innerHTML=recentWins.slice(0,6).map(r=>{const l=levelBy(r.level_id),pl=playerBy(r.player_id);return l&&pl?`<div class="adminRow row between"><span>🏆 <a href="player.html?id=${pl.id}"><b>${esc(pl.name)}</b></a> conquered <a href="level.html?id=${l.id}">#${l.rank} ${esc(l.name)}</a></span><span class="meta">${new Date(r.created_at).toLocaleDateString()}</span></div>`:''}).join('')||'<p class="meta">No victories in the last 24 hours.</p>';
 $('liveFeed').innerHTML=D.news.map(n=>`<div class="adminRow"><b>${esc(n.title)}</b><span class="meta"> · ${new Date(n.created_at).toLocaleDateString()}</span><div class="small">${esc(n.body)}</div></div>`).join('')||D.history.slice(0,5).map(h=>`<div class="adminRow">📈 ${esc(levelBy(h.level_id)?.name||'Level')} → #${h.rank}</div>`).join('')||'<p class="meta">No live events yet.</p>';
 const totalPoints=D.lb.reduce((s,x)=>s+Number(x.total_points||0),0),main=D.levels.filter(x=>x.section==='main').length,extended=D.levels.filter(x=>x.section==='extended').length; $('homeStats').innerHTML=`<div><span>Main levels</span><b>${main}</b></div><div><span>Extended levels</span><b>${extended}</b></div><div><span>Legacy levels</span><b>${D.levels.length-main-extended}</b></div><div><span>Total player points</span><b>${totalPoints.toLocaleString()}</b></div><div><span>Levels with victories</span><b>${new Set(D.records.map(r=>r.level_id)).size}</b></div><div><span>Average victories / level</span><b>${D.levels.length?(D.records.length/D.levels.length).toFixed(1):'0'}</b></div>`;
 const byDay={};D.records.slice(0,60).forEach(r=>{const k=new Date(r.created_at).toLocaleDateString(undefined,{month:'short',day:'numeric'});byDay[k]=(byDay[k]||0)+1});if(homeChart)homeChart.destroy();const ctx=$('homeActivityChart')?.getContext('2d');if(ctx&&window.Chart)homeChart=new Chart(ctx,{type:'line',data:{labels:Object.keys(byDay).reverse(),datasets:[{label:'Victories',data:Object.values(byDay).reverse(),tension:.3,fill:true,borderWidth:2}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:'#cbd0e4'}}},scales:{x:{ticks:{color:'#9da4bd'}},y:{beginAtZero:true,ticks:{color:'#9da4bd'}}}}});}
function recentMovement(levelId){const now=Date.now(),rows=D.history.filter(h=>h.level_id===levelId).slice().sort((a,b)=>new Date(b.recorded_at)-new Date(a.recorded_at));const latest=rows[0];if(!latest||now-new Date(latest.recorded_at).getTime()>864e5)return null;const prev=rows.find(h=>new Date(h.recorded_at)<new Date(latest.recorded_at));if(!prev||Number(prev.rank)===Number(latest.rank)&&prev.section===latest.section)return null;const delta=Number(prev.rank)-Number(latest.rank);return {from:prev.rank,to:latest.rank,delta,up:delta>0,sectionChanged:prev.section!==latest.section}}function movementBadge(levelId){const m=recentMovement(levelId);if(!m)return '';const arrow=m.up?'▲':'▼',amt=Math.abs(m.delta);const text=m.sectionChanged?`${arrow} ${amt} · moved ${m.up?'up':'down'} / section`: `${arrow} ${amt}`;return `<span class="tag ${m.up?'rankUp':'rankDown'} movementBadge" title="Moved ${m.up?'up':'down'} ${amt} spot${amt===1?'':'s'} in the last 24 hours">${text}</span>`}function linkCard(id,obj,label,page){const el=$(id);if(!el)return;if(obj){el.textContent=label;el.href=`${page}?id=${obj.id}`}else{el.textContent=label;el.removeAttribute('href')}}function linkPlayer(id,obj){const el=$(id);if(!el)return;if(obj){el.textContent=obj.name;el.href=`player.html?id=${obj.id}`}else{el.textContent='No players';el.removeAttribute('href')}}function renderMover(id,arr,up){$(id).innerHTML=arr.map(x=>x.l?`<a class="adminRow row between" href="level.html?id=${x.l.id}"><span><b>#${x.to} · ${esc(x.l.name)}</b><span class="meta"> #${x.from} → #${x.to}</span></span><strong class="${up?'rankUp':'rankDown'}">${up?'+':''}${x.delta}</strong></a>`:'').join('')||'<p class="meta">No recorded movement yet.</p>'}
function fillFilters(){const ds=[...new Set(D.levels.map(x=>x.difficulty).filter(Boolean))].sort();const ss=[...new Set(D.levels.map(x=>x.status).filter(Boolean))].sort();$('difficultyFilter').innerHTML='<option value="">Any difficulty</option>'+ds.map(x=>`<option>${esc(x)}</option>`).join('');$('statusFilter').innerHTML='<option value="">Any status</option>'+ss.map(x=>`<option>${esc(x)}</option>`).join('')}
function renderList(){fillFilters();const sec=$('section').value, q=($('search').value||'').toLowerCase().trim(),sort=$('sort').value,diff=$('difficultyFilter').value,status=$('statusFilter').value,min=Number($('minVictories').value||0);const rm=q.match(/^#?(\d+)$/),tm=q.match(/^top\s*(\d+)$/);let a=D.levels.filter(x=>x.section===sec&&(!diff||x.difficulty===diff)&&(!status||x.status===status)&&wins(x.id)>=min);if(rm)a=a.filter(x=>Number(x.rank)===Number(rm[1]));else if(tm)a=a.filter(x=>Number(x.rank)<=Number(tm[1]));else a=a.filter(x=>[x.name,x.creator,x.verifier,x.holder,x.aliases,x.difficulty,x.status,x.notes].join(' ').toLowerCase().includes(q));a.sort((x,y)=>sort==='name'?x.name.localeCompare(y.name):sort==='points'?p(y.rank)-p(x.rank):sort==='victories'?wins(y.id)-wins(x.id):x.rank-y.rank);$('list').innerHTML=a.map(l=>`<a class="levelCard rankAnimated" href="level.html?id=${l.id}"><div class="thumb">${l.thumbnail_url?`<img src="${esc(l.thumbnail_url)}" alt="">`:`<span>${esc((l.name||'?')[0])}</span>`}</div><div><div class="rank">#${l.rank} · ${esc(l.section)} ${movementBadge(l.id)}</div><div class="levelTitle">${esc(l.name)}</div><div class="meta">${esc(l.creator||'Unknown creator')} · ${esc(l.verifier||'No verifier')}${l.difficulty?' · '+esc(l.difficulty):''}</div><div class="chips">${l.status?`<span class="tag">${esc(l.status)}</span>`:''}<span class="tag">${wins(l.id)} victories</span></div></div><div class="points">${p(l.rank)}<small>points</small></div></a>`).join('')||'<div class="panel">No levels match.</div>';$('notice').innerHTML=`<div class="listSummary"><span><b>${a.length}</b> shown</span><span><b>${sec.toUpperCase()}</b></span></div>`}
['search','sort','section','difficultyFilter','statusFilter','minVictories'].forEach(id=>$(id)?.addEventListener('input',renderList));$('clearSearch').onclick=()=>{$('search').value='';renderList()};$('randomBtn').onclick=()=>{const a=D.levels.filter(x=>x.section===$('section').value);if(a.length)location.href=`level.html?id=${a[Math.floor(Math.random()*a.length)].id}`};document.addEventListener('keydown',e=>{if(e.key==='/'&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)){e.preventDefault();$('search').focus()}});load();